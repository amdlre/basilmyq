# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/basilmyq"

# Auth — single admin, no user table
# Run `npm run hash-password` and paste its output verbatim.
# NOTE: every `$` in the bcrypt hash must be escaped as `\$`. Next.js expands
# unescaped `$` sequences in env files, which would blank the hash out silently.
ADMIN_EMAIL="basil@basilmyq.com"
ADMIN_PASSWORD_HASH=''              # e.g. '\$2b\$12\$abc…'
AUTH_SECRET=''                      # openssl rand -base64 32

# Site
NEXT_PUBLIC_SITE_URL="https://basilmyq.com"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# Email
RESEND_API_KEY=""
CONTACT_TO_EMAIL="basil@basilmyq.com"

# Uploads — images are stored on local disk. In Docker, mount a volume here.
UPLOAD_DIR=""                       # defaults to ./uploads
